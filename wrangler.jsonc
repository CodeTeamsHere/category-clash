{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "category-clash",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    // The Cloudflare Vite plugin fills in the asset directory at build time.
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker; everything else is served as a static file.
    "run_worker_first": ["/ws/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "PUBLIC_LOBBY", "class_name": "PublicLobby" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "PublicLobby"] }]
}
